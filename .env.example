# Flask
FLASK_APP=run.py
APP_ENV=development
SECRET_KEY=replace-with-a-secure-secret
DEBUG=true
PORT=5000

# Database
# Relative SQLite paths are resolved inside the Flask instance directory.
DATABASE_URL=sqlite:///pomodoro.db

# Pomodoro defaults
DEFAULT_TIMEZONE=Europe/Kyiv
DEFAULT_CYCLES_BEFORE_LONG_BREAK=4
POMODORO_TEST_MODE=false

# Google Calendar (optional)
# Leave both required values blank to keep Calendar unconfigured. The current
# implementation has no separate GOOGLE_CALENDAR_ENABLED flag.
# Prefer the Calendar ID from Settings -> Integrate calendar. An official
# Google Calendar embed URL is also accepted when it contains src=. Other URLs,
# share links, and HTML snippets are rejected.
GOOGLE_CALENDAR_ID=
# One-line service-account JSON. Keep the real value only in local .env, wrap
# it in single quotes, and never commit or paste the private key into docs.
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# Optional event presentation settings.
GOOGLE_CALENDAR_EVENT_PREFIX=Pomodoro
GOOGLE_CALENDAR_EVENT_COLOR_ID=

# Google Sheets integration (optional)
GOOGLE_SHEETS_ENABLED=false

# ID from:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# One-line service-account JSON. Keep the real value only in local .env and
# never commit it. The spreadsheet itself must be shared with client_email.
GOOGLE_SHEETS_CREDENTIALS_JSON=
