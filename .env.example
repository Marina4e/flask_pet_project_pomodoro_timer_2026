# Flask
FLASK_APP=run.py
APP_ENV=development
SECRET_KEY=replace-with-a-secure-secret
DEBUG=true
PORT=5000

# Database
# Relative SQLite paths are resolved inside the Flask instance directory.
DATABASE_URL=sqlite:///pomodoro.db

# Pomodoro defaults
DEFAULT_TIMEZONE=Europe/Kyiv
DEFAULT_CYCLES_BEFORE_LONG_BREAK=4
POMODORO_TEST_MODE=false

# Google Calendar (optional)
# Calendar ID and one-line service-account JSON are both required for sync.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_EVENT_PREFIX=Pomodoro
GOOGLE_CALENDAR_EVENT_COLOR_ID=

# Google Sheets integration (optional)
GOOGLE_SHEETS_ENABLED=false

# ID from:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# One-line service-account JSON. Keep the real value only in .env.
GOOGLE_SHEETS_CREDENTIALS_JSON=
